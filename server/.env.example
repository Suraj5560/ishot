# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Set to your MongoDB Atlas connection string or local MongoDB instance:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ishot?retryWrites=true&w=majority
# If left empty, an embedded in-memory MongoDB instance will be automatically started for development/demo.
MONGODB_URI=mongodb://127.0.0.1:27017/ishot

# Cloudinary Credentials (Required for uploads & OCR)
# Get these from your Cloudinary Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=findshot
 
# Google Gemini API Key (Required for Flash Vision OCR, AI Captioning, Auto-Tagging & Sensitive Data Detection)
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_min_32_chars_random_string

# Upload Quota & Rate Limiting
MAX_UPLOADS_PER_USER=25

# Allowed Client Origins for CORS (comma-separated)
CLIENT_ORIGINS=http://localhost:5173,https://your-app.vercel.app
