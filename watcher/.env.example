# Path to the directory where screenshots are saved on your computer.
# Examples:
#   Windows: C:\Users\YourUsername\Pictures\Screenshots or ./screenshots
#   macOS: /Users/YourUsername/Desktop or ./screenshots
SCREENSHOT_DIR=./screenshots

# Backend API upload endpoint (or your live Render URL: https://your-app.onrender.com/api/upload)
API_URL=http://localhost:5000/api/upload

# ishot user credentials (authenticated per-user uploads)
# Never share or commit your password
ISHOT_EMAIL=
ISHOT_PASSWORD=

# Upload retry settings
MAX_RETRIES=3
RETRY_DELAY_MS=1500
